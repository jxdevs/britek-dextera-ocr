NODE_ENV=development
PORT=3000

# Gemini — obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Precios por 1M tokens (USD) para estimar costo en el banco de pruebas.
# Ajustar según la página de pricing oficial.
GEMINI_FLASH_INPUT_PRICE=0.30
GEMINI_FLASH_OUTPUT_PRICE=2.50
GEMINI_PRO_INPUT_PRICE=1.25
GEMINI_PRO_OUTPUT_PRICE=10.00

# CORS — origen del frontend
CORS_ORIGIN=http://localhost:5173

# Database (Postgres en Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ocrdemo
DB_USER=ocrdemo
DB_PASSWORD=ocrdemo
DB_SYNC=true

# JWT (se usa en Sprint 1.1)
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_IN=8h

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# Kapso (WhatsApp). Dejá KAPSO_WEBHOOK_SECRET vacío en dev para no validar firma.
KAPSO_WEBHOOK_SECRET=
KAPSO_API_KEY=your-kapso-api-key-here
KAPSO_API_URL=https://api.kapso.ai/v1
KAPSO_PHONE_NUMBER_ID=your-phone-number-id-here

# Google OAuth — obtener en https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_SECRET_KEY=your-google-secret-key-here