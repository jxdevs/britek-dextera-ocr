NODE_ENV=development
PORT=3000

# Gemini — obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Precios por 1M tokens (USD) para estimar costo en el banco de pruebas.
# Ajustar según la página de pricing oficial.
GEMINI_FLASH_INPUT_PRICE=0.30
GEMINI_FLASH_OUTPUT_PRICE=2.50
GEMINI_PRO_INPUT_PRICE=1.25
GEMINI_PRO_OUTPUT_PRICE=10.00

# CORS — origen del frontend
CORS_ORIGIN=http://localhost:5173

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ocrdemo
DB_USER=ocrdemo
DB_PASSWORD=ocrdemo
# DB_SYNC=true en dev hace que Sequelize sincronice el schema al arrancar.
# En prod siempre debe estar en false y usar migrations.
DB_SYNC=true

# JWT
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=8h

# Storage (local en dev, GCS en prod)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# Kapso (WhatsApp Business Platform)
# Dejar KAPSO_WEBHOOK_SECRET vacío en dev para no validar firma.
# En prod siempre setearlo. La firma esperada es:
#   header  X-Kapso-Signature: sha256=<hmac(body, secret)>
KAPSO_WEBHOOK_SECRET=
KAPSO_API_KEY=
KAPSO_API_URL=https://api.kapso.ai/v1
